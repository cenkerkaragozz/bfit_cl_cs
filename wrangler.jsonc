{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  // Must match the Worker name in Cloudflare (Workers Builds project "brainfit").
  // WORKER_SELF_REFERENCE below points at this same name.
  "name": "brainfit",
  "compatibility_date": "2026-08-13",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "brainfit"
    }
  ],
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "bfit-cl-cs-opennext-cache"
    }
  ],
  "images": {
    "binding": "IMAGES"
  }
}
